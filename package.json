{
  "name": "local-daily-dashboard",
  "version": "0.1.0",
  "description": "A local-first dashboard with cached briefings, local notes, and a read-only MCP interface.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node scripts/run-local.mjs dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node scripts/run-local.mjs start",
    "collector": "node scripts/grok-x-collector.mjs",
    "daemon": "node --import tsx scripts/dashboard-daemon.ts",
    "mcp": "node --import tsx scripts/dashboard-mcp.ts",
    "mcp:check-remote": "node --import tsx scripts/dashboard-mcp.ts --check-remote",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "jose": "^6.2.4",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.48.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.32",
    "eslint": "10.8.0",
    "globals": "16.5.0",
    "react-server-dom-webpack": "19.2.8",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.115.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  },
  "type": "module"
}
