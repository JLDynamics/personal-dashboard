# Optional display personalization
DASHBOARD_DISPLAY_NAME=Your name

# Neutral sample weather values. Put your real values only in ignored
# `.env.local`, and change all four together.
DASHBOARD_WEATHER_LATITUDE=0
DASHBOARD_WEATHER_LONGITUDE=0
DASHBOARD_WEATHER_LOCATION=Sample location
DASHBOARD_TIME_ZONE=UTC

# Optional: use a non-standard Grok CLI installation.
# GROK_CLI_PATH=/absolute/path/to/grok

# Agent-note defaults to the sibling ../Agent-note project and its local CLI.
# AGENT_NOTE_PROJECT_DIR=/absolute/path/to/Agent-note
# AGENT_NOTE_CLI_PATH=/absolute/path/to/agent-note

# Optional local cache/service overrides. The defaults live under .local/
# and bind only to localhost.
# DASHBOARD_DATABASE_PATH=/absolute/path/to/dashboard.sqlite3
# DASHBOARD_DAEMON_PORT=8790
# DASHBOARD_MCP_PORT=8791

# Optional authenticated remote MCP doorway for a Claude custom connector.
# Keep these values outside source control. The remote listener must remain
# loopback-only and must be published through an HTTPS tunnel.
# DASHBOARD_MCP_PUBLIC_URL=https://dashboard.example.com/mcp
# DASHBOARD_MCP_ISSUER_URL=https://your-issuer.example.com/
# DASHBOARD_MCP_JWKS_URL=https://your-issuer.example.com/.well-known/jwks.json
# DASHBOARD_MCP_AUDIENCE=https://dashboard.example.com/mcp
# DASHBOARD_MCP_ALLOWED_SUBJECT=your-approved-user-id
# DASHBOARD_MCP_REQUIRED_SCOPE=dashboard-read
# Leave empty only when the provider cannot issue custom scopes and the
# connector remains protected by an exact audience, identity, and read-only
# tool surface.
# DASHBOARD_MCP_REMOTE_HOST=127.0.0.1
# DASHBOARD_MCP_REMOTE_PORT=8792
